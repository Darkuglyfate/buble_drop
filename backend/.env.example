PORT=3000
# `seed:reference-data` is production-safe. `seed:demo` refuses NODE_ENV=production.
# Comma-separated allowlist. In production include the deployed BubbleDrop frontend origin.
FRONTEND_ORIGIN=http://localhost:3001

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=bubbledrop
# DATABASE_URL enables verified TLS by default. Host-based production config does the same.
# Set DB_SSL=false only for a trusted plaintext local network.
DB_SSL=
# Non-production troubleshooting only. Production rejects this override.
DB_SSL_ALLOW_SELF_SIGNED=false

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=
REDIS_TLS=false

# Use a stable Base mainnet RPC in production.
BASE_RPC_URL=https://mainnet.base.org
GASLESS_RELAY_ENABLED=0
GASLESS_DAILY_CHECK_IN_ENABLED=0
GASLESS_CLAIM_ENABLED=0
GASLESS_OWNERSHIP_ENABLED=0
GASLESS_SESSION_OUTCOME_ENABLED=0
READINESS_TIMEOUT_MS=3000
# Replace this before any production deploy. Do not keep the example value.
AUTH_SESSION_SECRET=replace-with-a-long-random-string
# SIWE nonce TTL in positive whole seconds (300 by default). Keep this short to limit replay windows.
AUTH_NONCE_TTL_SECONDS=300
# Maximum allowed SIWE client clock skew in whole seconds (60 by default).
SIWE_MAX_CLOCK_SKEW_SECONDS=60
# SIWE browser allowlists. Set both to deployed values in production; empty production allowlists reject all sign-ins.
# Domains use host[:port]; URIs must be exact http/https origins or URLs, comma-separated when needed.
SIWE_ALLOWED_DOMAINS=localhost:3001
SIWE_ALLOWED_URIS=http://localhost:3001
# Optional until live payout is enabled. Must match the signer derived from REWARD_WALLET_PRIVATE_KEY.
REWARD_WALLET_ADDRESS=0x0000000000000000000000000000000000000000
# Optional until live payout is enabled. Must be a 32-byte hex private key when set.
REWARD_WALLET_PRIVATE_KEY=
# Wait for this many canonical Base blocks before finalizing a reward-wallet payout.
REWARD_PAYOUT_MIN_CONFIRMATIONS=2
# Reconcile and rebroadcast durable payout outbox rows at this interval (minimum 1000 ms).
PAYOUT_RECONCILIATION_INTERVAL_MS=15000
REWARD_LEDGER_CONTRACT_ADDRESS=
REWARD_LEDGER_WRITER_PRIVATE_KEY=
REWARD_LEDGER_WRITER_ADDRESS=
SESSION_OUTCOME_CONTRACT_ADDRESS=
SESSION_OUTCOME_SIGNER_PRIVATE_KEY=
SESSION_OUTCOME_SIGNER_ADDRESS=
# Enable onchain daily check-in streak writes (1 = enabled, 0 = disabled).
ONCHAIN_STREAK_ENABLED=0
# Deployed DailyCheckInStreak contract address on Base mainnet.
ONCHAIN_STREAK_CONTRACT_ADDRESS=
# Single-key mode: one private key for deploy + writer signer.
ONCHAIN_STREAK_PRIVATE_KEY=
# Private key for the authorized contract writer (backend signer).
ONCHAIN_STREAK_SIGNER_PRIVATE_KEY=
# Optional safety check: expected signer address derived from ONCHAIN_STREAK_SIGNER_PRIVATE_KEY.
ONCHAIN_STREAK_SIGNER_ADDRESS=
# Wait for this many canonical Base blocks before a user-paid check-in grants XP.
CHECK_IN_MIN_CONFIRMATIONS=2
ONBOARDING_XP_AMOUNT=20

# QA override: unlock and allow applying all skins (1 = enabled, 0 = disabled).
BUBBLEDROP_TEST_UNLOCK_ALL_SKINS=0
